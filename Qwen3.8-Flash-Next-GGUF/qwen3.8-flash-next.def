Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu24.04

%labels
    Author giacolees
    Description llama.cpp CUDA/NCCL server for Qwen3.8-Flash-Next GGUF

%environment
    export PATH=/opt/llama.cpp/build/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export GGML_CUDA_P2P=1
    export CUDA_VISIBLE_DEVICES=0,1,2,3
    export MODEL_PATH=/models/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf
    export LLAMA_HOST=0.0.0.0
    export LLAMA_PORT=8081
    export LLAMA_CTX=65536
    export LLAMA_PARALLEL=1
    export LLAMA_BATCH=4096
    export LLAMA_UBATCH=512
    export LLAMA_CACHE_K=q8_0
    export LLAMA_CACHE_V=q8_0
    export LLAMA_TENSOR_SPLIT=1,1,1,1
    export LLAMA_CACHE_REUSE=256
    # Keep the large Qwen n-gram/PLE table in host RAM instead of GPU VRAM.
    export LLAMA_OVERRIDE_TENSOR=per_layer_token_embd=CPU
    export LLAMA_FIT_TARGET=2048
    export LLAMA_REASONING=off

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libcurl4-openssl-dev \
        libgomp1 \
        libssl-dev \
        ninja-build \
        pkg-config

    # CUDA devel images may already contain NVIDIA-pinned / held NCCL packages.
    # Keep those exact packages instead of asking apt to upgrade held packages.
    dpkg-query -W -f='${Status} ${Version}\n' libnccl2 libnccl-dev || true
    rm -rf /var/lib/apt/lists/*

    # The official repository is public, but allow an authenticated clone for
    # a private fork. The optional build-env file is bind-mounted by the
    # 4xa100 build instructions; it is never copied into the image. Disable
    # xtrace for this entire block so the token cannot appear in build logs.
    set +x
    if [[ -r /tmp/llama-build.env ]]; then
        # shellcheck disable=SC1091
        source /tmp/llama-build.env
    fi
    LLAMA_REPO="${LLAMA_REPO:-https://github.com/ggml-org/llama.cpp.git}"
    if [[ -n "${GITHUB_PAT:-}" ]]; then
        GITHUB_AUTH="$(printf 'x-access-token:%s' "${GITHUB_PAT}" | base64 -w 0)"
        git -c "http.extraheader=AUTHORIZATION: basic ${GITHUB_AUTH}" \
            clone --depth 1 "${LLAMA_REPO}" /opt/llama.cpp
    else
        git clone --depth 1 "${LLAMA_REPO}" /opt/llama.cpp
    fi
    unset GITHUB_AUTH GITHUB_PAT LLAMA_REPO
    set -x
    cd /opt/llama.cpp

    # The SIF build environment has no NVIDIA kernel driver and this CUDA image
    # does not ship libcuda.so stubs. Permit unresolved CUDA Driver API symbols
    # in shared-library dependencies; `singularity run --nv` supplies libcuda.so.1.
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_CUDA=ON \
        -DGGML_CUDA_NCCL=ON \
        -DCMAKE_CUDA_ARCHITECTURES=80 \
        -DLLAMA_CURL=ON \
        -DLLAMA_OPENSSL=ON \
        -DCMAKE_EXE_LINKER_FLAGS="-Wl,--allow-shlib-undefined" \
        -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--allow-shlib-undefined"

    cmake --build build --target llama-server llama-cli -j "$(nproc)"
    strip build/bin/llama-server build/bin/llama-cli || true
    mkdir -p /models /var/cache/llama.cpp

    cat > /usr/local/bin/start-qwen-server <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

: "${MODEL_PATH:=/models/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf}"
: "${LLAMA_HOST:=0.0.0.0}"
: "${LLAMA_PORT:=8081}"
: "${LLAMA_CTX:=65536}"
: "${LLAMA_PARALLEL:=1}"
: "${LLAMA_BATCH:=4096}"
: "${LLAMA_UBATCH:=512}"
: "${LLAMA_CACHE_K:=q8_0}"
: "${LLAMA_CACHE_V:=q8_0}"
: "${LLAMA_TENSOR_SPLIT:=1,1,1,1}"
: "${LLAMA_CACHE_REUSE:=256}"
: "${LLAMA_OVERRIDE_TENSOR:=per_layer_token_embd=CPU}"
: "${LLAMA_FIT_TARGET:=2048}"
: "${LLAMA_REASONING:=off}"

if [[ ! -r "$MODEL_PATH" ]]; then
    echo "ERROR: model is not readable: $MODEL_PATH" >&2
    echo "Bind the host model directory to /models or set SINGULARITYENV_MODEL_PATH." >&2
    exit 2
fi

exec /opt/llama.cpp/build/bin/llama-server \
    --model "$MODEL_PATH" \
    --host "$LLAMA_HOST" \
    --port "$LLAMA_PORT" \
    --jinja \
    --n-gpu-layers all \
    --split-mode layer \
    --tensor-split "$LLAMA_TENSOR_SPLIT" \
    --fit on \
    --fit-target "$LLAMA_FIT_TARGET" \
    --flash-attn on \
    --override-tensor "$LLAMA_OVERRIDE_TENSOR" \
    --cache-type-k "$LLAMA_CACHE_K" \
    --cache-type-v "$LLAMA_CACHE_V" \
    --ctx-size "$LLAMA_CTX" \
    --parallel "$LLAMA_PARALLEL" \
    --batch-size "$LLAMA_BATCH" \
    --ubatch-size "$LLAMA_UBATCH" \
    --cont-batching \
    --cache-prompt \
    --cache-reuse "$LLAMA_CACHE_REUSE" \
    --metrics \
    --slots \
    --reasoning "$LLAMA_REASONING" \
    "$@"
SCRIPT
    chmod 0755 /usr/local/bin/start-qwen-server

%test
    # libcuda.so.1 is injected only when running with --nv.
    # Do not execute CUDA-linked binaries during the SIF build.
    test -x /opt/llama.cpp/build/bin/llama-server
    test -x /opt/llama.cpp/build/bin/llama-cli
    test -x /usr/local/bin/start-qwen-server

    test -f /opt/llama.cpp/build/bin/libggml-cuda.so.0.17.0 || \
        find /opt/llama.cpp/build/bin \
            -maxdepth 1 \
            -name 'libggml-cuda.so*' |
        grep -q .

%runscript
    exec /usr/local/bin/start-qwen-server "$@"

%help
    Build:
      ./build-qwen-sif.sh

    The helper uses the unprivileged --fakeroot build mode.

    Run:
      singularity run --nv \
        --bind /davinci-1/work/glisita/huggingface_cache/gguf/Qwen3.8-Flash-Next-GGUF/UD-IQ3_XXS:/models:ro \
        qwen3.8-flash-next-llamacpp.sif

    The first GGUF shard is the entry point; all shards in the same directory
    must be present. The launcher in this repository selects the quantization
    appropriate for each hardware profile.
