# =============================================================================
# Hardware Profile: 2× NVIDIA RTX A6000 48GB
# Total VRAM:       96 GB
# GPU topology:     2 GPUs, PCIe connected (no NVLink)
# Use case:         Single-user inference, smaller models, lower batch sizes
# =============================================================================

# --- Shared GPU layout ---
CUDA_VISIBLE_DEVICES="0,1"
GPU_COUNT=2

# --- llama.cpp / DwarfStar split mode ---
# Even split across 2 GPUs
TENSOR_SPLIT="1,1"
SPLIT_MODE="layer"

# --- vLLM tensor parallelism ---
TENSOR_PARALLEL_SIZE=2

# --- NCCL / P2P ---
# A6000 pairs typically lack NVLink; disable P2P to avoid fallback overhead
GGML_CUDA_P2P=0
NCCL_DEBUG=WARN

# --- Memory budgets ---
# Higher fraction available since fewer GPUs and less total VRAM
KV_CACHE_FRACTION=0.40

# --- NUMA topology (single socket workstation typically) ---
NUMA_CPUNODEBIND="0"
NUMA_INTERLEAVE="0"
