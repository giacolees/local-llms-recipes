# =============================================================================
# Qwen3.8-Flash-Next GGUF overrides for 2×A6000 (96 GB)
# llama.cpp-based server via Singularity
# =============================================================================

# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES=0,1
#   TENSOR_SPLIT=1,1
#   GGML_CUDA_P2P=0

# --- Model ---
# IQ3_XXS leaves room for the KV cache on 96 GB of total VRAM.
MODEL_DIR="${GGUF_MODELS_DIR:-/davinci-1/work/glisita/huggingface_cache/gguf}/Qwen3.8-Flash-Next-GGUF/UD-IQ3_XXS"
MODEL_FILE="Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf"
IMAGE="/davinci-1/home/glisita/Projects/local-LLMs/Qwen3.8-Flash-Next-GGUF/qwen3.8-flash-next-llamacpp.sif"

# --- Server (reduced for 96 GB) ---
HOST="0.0.0.0"
PORT=8081
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=2048
UBATCH_SIZE=256
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
# Keep the n-gram/PLE table in host RAM instead of GPU VRAM.
OVERRIDE_TENSOR="per_layer_token_embd=CPU"
FIT_TARGET=2048
REASONING="off"
LOG_LEVEL=4
