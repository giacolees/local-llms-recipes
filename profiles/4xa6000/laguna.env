# =============================================================================
# Laguna S 2.1 overrides for 4×A6000 (2 nodes × 96 GB; runs on the local node)
# llama.cpp with DFlash speculative decoding via Singularity
# =============================================================================

# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES=0,1
#   TENSOR_SPLIT=1,1
#   GGML_CUDA_P2P=0

# --- Model ---
MODEL_PATH="/davinci-1/work/glisita/huggingface_cache/gguf/Laguna-S-2.1-GGUF/UD-Q6_K/Laguna-S-2.1-UD-Q6_K-00001-of-00003.gguf"
DRAFT_MODEL_PATH=""  # Speculative decoding less beneficial on 2-GPU PCIe

# --- Server (reduced for 96 GB / 2 GPUs) ---
LLAMA_HOST="0.0.0.0"
LLAMA_PORT=8000
LLAMA_CTX=131072           # Smaller context
LLAMA_PARALLEL=1
LLAMA_BATCH=2048
LLAMA_UBATCH=256
LLAMA_CACHE_K="q8_0"
LLAMA_CACHE_V="q8_0"
LLAMA_CACHE_REUSE=256
LLAMA_SPEC_DRAFT_N_MAX=8   # Fewer draft tokens on slower interconnect
