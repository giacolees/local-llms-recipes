# =============================================================================
# vLLM-on-Docker recipe settings for 4× NVIDIA RTX A6000 48GB (2 nodes × 96 GB, 96 GB per node)
#
# Shared plumbing for everything under vllm-docker/. Per-model sizing lives in
# vllm-docker/models/<key>.env (already tuned for 96 GB). To override a single
# model from here, use <MODEL_KEY>_<VAR> — e.g.:
#   GEMMA4_E4B_REPLICAS=10          # fewer replicas
#   GEMMA4_26B_A4B_MAX_MODEL_LEN=262144
# Command-line env vars beat these, which beat recipe defaults.
# =============================================================================

# --- Container image ---
VLLM_IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:latest}"

# --- Model cache on this machine (mounted into every container) ---
HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
# Gemma models are gated on HF — export HF_TOKEN before starting a recipe.

# --- Networking ---
BIND_HOST="${BIND_HOST:-127.0.0.1}"   # set 0.0.0.0 to serve the LAN
CLIENT_HOST="${CLIENT_HOST:-127.0.0.1}"

# --- Replica placement ---
# TP=1 recipes pin replicas round-robin over CUDA_VISIBLE_DEVICES (from config.env).
# TP>1 recipes see all GPUs and use --tensor-parallel-size instead.

# --- Readiness ---
READY_TIMEOUT="${READY_TIMEOUT:-1800}"  # first start streams weights into HF_HOME

# --- Example per-model overrides (uncomment to use) ---
# GEMMA4_E4B_REPLICAS=10
# GEMMA4_E4B_GPU_MEM_UTIL=0.17
# QWEN3.6_35B_A3B_MAX_MODEL_LEN=65536
# QWEN3_5_35B_A3B_MAX_MODEL_LEN=65536
