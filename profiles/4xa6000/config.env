# =============================================================================
# Hardware Profile: 4× NVIDIA RTX A6000 48GB across 2 nodes (2 per node)
# Total VRAM:       192 GB (2 nodes × 96 GB)
# GPU topology:     per node: 2 GPUs, PCIe connected (no NVLink)
# Interconnect:     10 GbE point-to-point/switch between the two nodes
# Use case:         Multi-node vLLM (TP=2 inside a node × PP=2 across nodes)
#                   and the single-node recipes (they see the local 2 GPUs)
# =============================================================================

# --- Shared GPU layout (per node) ---
CUDA_VISIBLE_DEVICES="0,1"
GPU_COUNT=2

# --- Cluster topology ---
GPU_NODES=2
TOTAL_GPUS=4

# --- llama.cpp / DwarfStar split mode (per node) ---
# Even split across the 2 local GPUs
TENSOR_SPLIT="1,1"
SPLIT_MODE="layer"

# --- vLLM parallelism ---
# Keep TP inside a single node (PCIe) and put one PP stage on each node.
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=2

# --- NCCL / P2P ---
# A6000 pairs typically lack NVLink; disable P2P to avoid fallback overhead.
# The inter-node link is plain Ethernet, so no InfiniBand/RDMA.
GGML_CUDA_P2P=0
NCCL_DEBUG=WARN
NCCL_IB_DISABLE=1

# --- Memory budgets ---
# Higher fraction available since fewer GPUs and less total VRAM per node.
KV_CACHE_FRACTION=0.40

# --- NUMA topology (single socket workstation typically) ---
NUMA_CPUNODEBIND="0"
NUMA_INTERLEAVE="0"
