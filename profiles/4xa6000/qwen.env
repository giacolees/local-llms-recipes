# =============================================================================
# Qwen3.6-27B overrides for 4×A6000 (2 nodes × 96 GB; runs on the local node)
# vLLM OpenAI-compatible server via Singularity
# =============================================================================

# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES=0,1
#   TENSOR_PARALLEL_SIZE=2

# --- Model ---
MODEL="Qwen/Qwen3.6-27B"
IMAGE="/davinci-1/home/glisita/Projects/local-LLMs/vllm-openai.sif"
HF_HOME="${HF_HOME:-/davinci-1/work/glisita/huggingface_cache}"

# --- Server (reduced for 96 GB / 2 GPUs) ---
HOST="0.0.0.0"
PORT=8000
MAX_MODEL_LEN=65536         # Shorter max context on 96 GB
REASONING_PARSER="qwen3"
ENABLE_AUTO_TOOL_CHOICE="true"
TOOL_CALL_PARSER="qwen3_xml"
