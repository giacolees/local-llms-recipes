# =============================================================================
# Qwen3.8-27B multi-node vLLM cluster overrides for 4×A6000 (2 nodes × 2 GPUs)
# Recipe:   Qwen3.8-27B-Cluster/
# Topology: head = 10.0.0.2 + worker1 = 10.0.0.3
#           TP=2 inside each node (PCIe), PP=2 across the 10 GbE link
# =============================================================================
#
# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES="0,1"   (per node)
#   GPU_COUNT=2                  (per node)
#   TENSOR_SPLIT="1,1"
#   GGML_CUDA_P2P=0
#   NCCL_IB_DISABLE=1
#   TENSOR_PARALLEL_SIZE=2
#   PIPELINE_PARALLEL_SIZE=2

# --- Cluster / container plumbing ---
IMAGE="vllm/vllm-openai:v0.30.0"   # must be identical on every node
CLUSTER_SHM_SIZE="16g"             # container /dev/shm
MODELS_DIR="/opt/models"           # host dir mounted into the containers
CONTAINER_MODELS_DIR="/models"     # mount point inside the containers
RAY_PORT=6379
RAY_VERSION="2.58.0"               # ray is NOT in the image; installed from wheels/
RAY_WHEELS="wheels"                # relative to MODELS_DIR
CONTAINER_PREFIX="vllm-ray"        # container name = <prefix>-<node name>

# --- Nodes (first entry is the Ray head; run the scripts from that machine) ---
# ssh="" means the local machine. iface is the 10 GbE NIC used by NCCL/Gloo.
NODE_NAMES=(head worker1)
NODE_SSH=("" "root@10.0.0.3")
NODE_IPS=("10.0.0.2" "10.0.0.3")
NODE_IFACES=("enp153s0f1np1" "enp179s0f0np0")
NODE_GPUS=(2 2)
NODE_COUNT=2
# Add another workstation by appending to every array above, then run:
#   ./provision_node.sh <name>   # copy image/weights/wheels over the LAN
#   ./cluster_up.sh --sync       # join it to the Ray cluster

# --- Model ---
MODEL_NAME="qwen3.8-27b"                       # served model name
MODEL_REPO="Qwen/Qwen3.8-27B"
MODEL_HOST_PATH="${MODELS_DIR}/Qwen3.8-27B"    # host path on every node
MODEL_PATH="${CONTAINER_MODELS_DIR}/Qwen3.8-27B"
MODEL_MAX_LEN=262144

# --- Serve ---
TP_SIZE=2                          # keep TP inside a single node
PP_SIZE=2                          # one PP stage per node
BACKEND="ray"
GPU_MEM_UTIL=0.85
REASONING_PARSER="qwen3"           # splits thinking into reasoning_content
TOOL_PARSER=""                     # e.g. qwen3_xml
AUTO_TOOL_CHOICE=0
SPEC_METHOD="qwen3_5_mtp"          # built-in MTP head; empty disables
SPEC_TOKENS=3
SERVE_HOST="0.0.0.0"
SERVE_PORT=8000
SERVE_LOG_NAME="vllm.log"
EXTRA_ARGS=()                      # e.g. (--max-num-batched-tokens 8192)
