# =============================================================================
# vLLM-on-Docker recipe settings for 4× NVIDIA A100-SXM4-40GB (160 GB total)
#
# NOTE: the recipes in vllm-docker/models/ are sized for 96 GB (2×A6000): the
# per-GPU budget is expressed as GPU_MEM_UTIL × 40 GiB here, so replica counts
# and memory fractions must be re-tuned per model before use on this profile
# (use <MODEL_KEY>_<VAR> overrides below or run with explicit env vars).
# =============================================================================

# --- Container image ---
VLLM_IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:latest}"

# --- Model cache (mounted into every container) ---
HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
# Gemma models are gated on HF — export HF_TOKEN before starting a recipe.

# --- Networking ---
BIND_HOST="${BIND_HOST:-127.0.0.1}"
CLIENT_HOST="${CLIENT_HOST:-127.0.0.1}"

# --- Readiness ---
READY_TIMEOUT="${READY_TIMEOUT:-1800}"

# --- Per-model overrides for this hardware (examples) ---
# GEMMA4_E4B_REPLICAS=16            # 4 GPUs × 4 replicas
# GEMMA4_E4B_GPU_MEM_UTIL=0.18      # 0.18 × 40 GiB ≈ 7.2 GiB per replica
# QWEN3.6_35B_A3B_REPLICAS=2
# QWEN3.6_35B_A3B_GPU_MEM_UTIL=0.85
