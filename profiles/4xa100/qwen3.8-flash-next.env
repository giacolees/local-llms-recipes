# =============================================================================
# Qwen3.8-Flash-Next GGUF overrides for 4×A100 (160 GB)
# llama.cpp-based server via Singularity
# =============================================================================

# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES=0,1,2,3
#   TENSOR_SPLIT=1,1,1,1
#   GGML_CUDA_P2P=1

# --- Model ---
# Q4_K_XL provides higher quality while leaving room for the KV cache on 160 GB.
MODEL_DIR="${GGUF_MODELS_DIR:-/davinci-1/work/glisita/huggingface_cache/gguf}/Qwen3.8-Flash-Next-GGUF/UD-Q4_K_XL"
MODEL_FILE="Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"
IMAGE="/davinci-1/home/glisita/Projects/local-LLMs/Qwen3.8-Flash-Next-GGUF/qwen3.8-flash-next-llamacpp.sif"

# --- Server ---
HOST="0.0.0.0"
PORT=8081
CTX_SIZE=262144
PARALLEL=1
BATCH_SIZE=4096
UBATCH_SIZE=512
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
# Keep the n-gram/PLE table in host RAM instead of GPU VRAM.
OVERRIDE_TENSOR="per_layer_token_embd=CPU"
FIT_TARGET=2048
REASONING="off"
LOG_LEVEL=4
