# =============================================================================
# Hardware Profile: 4× NVIDIA A100-SXM4-40GB
# Total VRAM:       160 GB
# GPU topology:     4 GPUs, NVLink/SXM connected
# Use case:         Large model inference, multi-user serving, long context
# =============================================================================

# --- Shared GPU layout ---
CUDA_VISIBLE_DEVICES="0,1,2,3"
GPU_COUNT=4

# --- llama.cpp / DwarfStar split mode ---
# Even split across all 4 GPUs (each gets 1/4 of layers)
TENSOR_SPLIT="1,1,1,1"
SPLIT_MODE="layer"

# --- vLLM tensor parallelism ---
TENSOR_PARALLEL_SIZE=4

# --- NCCL / P2P ---
GGML_CUDA_P2P=1
NCCL_DEBUG=WARN

# --- Memory budgets ---
# Per-GPU KV cache budget (fraction of VRAM reserved for layers vs cache)
KV_CACHE_FRACTION=0.35

# --- NUMA topology (A100 SXM typically spans 2 sockets) ---
NUMA_CPUNODEBIND="0,1"
NUMA_INTERLEAVE="0,1"
