# =============================================================================
# Recipe: Gemma 4 26B-A4B — 26B total / 3.8B active MoE, BF16 (~51.6 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 1 replica, TP=2
#
#   per-GPU budget : 1 × 0.70 = 0.70 of 48 GiB (weights sharded across both GPUs)
#   per replica    : 33.6 GiB/GPU = ~25.8 weights + runtime + KV (fp8 @ 32K)
#
# Why: structured JSON + function calling at the 26B quality tier for a 3.8B
# active-param cost. One replica needs tensor parallelism across both GPUs; the
# 256K context headline needs a dedicated profile —
#   REPLICAS=1 TP=2 GPU_MEM_UTIL=0.90 MAX_MODEL_LEN=262144 ./run-model.sh gemma4-26b-a4b
# =============================================================================

# Upstream google/gemma-4-26B-A4B-it (BF16, ~51.6 GB). Gemma is gated on HF —
# export HF_TOKEN before launching. Override MODEL= for a quantized build.
MODEL="${MODEL:-google/gemma-4-26B-A4B-it}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-1}"                 # one TP=2 replica fits 96 GB
TP="${TP:-2}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.70}"      # 33.6 GiB per GPU of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"   # 256K ctx: use the dedicated profile above
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8400}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-hermes}"   # native function calling
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"                  # native structured JSON
EXPECT_REASONING="${EXPECT_REASONING:-0}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
