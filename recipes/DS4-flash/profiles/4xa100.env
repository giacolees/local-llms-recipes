# =============================================================================
# DS4-flash overrides for 4×A100
# llama.cpp-based DeepSeek V4 Flash server via Singularity
# =============================================================================

# Inherited from config.env:
#   CUDA_VISIBLE_DEVICES=0,1,2,3
#   TENSOR_SPLIT=1,1,1,1
#   SPLIT_MODE=layer
#   GGML_CUDA_P2P=1

# --- Model ---
MODEL_DIR="${GGUF_MODELS_DIR:-${HOME}/models/gguf}/DeepSeek-V4-Flash-UD-IQ3_XXS/UD-IQ3_XXS"
MODEL_FILE="DeepSeek-V4-Flash-UD-IQ3_XXS-00001-of-00004.gguf"

# --- Server ---
HOST="0.0.0.0"
PORT=8080
CTX_SIZE=524288
PARALLEL=4
BATCH_SIZE=4096
UBATCH_SIZE=512
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
LOG_LEVEL=4
