# =============================================================================
# Recipe: Qwen3.5-2B — 2B dense, BF16 (~4.5 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 4 replicas = 2 per GPU
#
#   per-GPU budget : 2 × 0.25 = 0.50 of 48 GiB
#   per replica    : 12.0 GiB = 4.5 weights + ~2.0 runtime + ~5.5 KV (fp8 @ 32K)
#
# Why: smallest Qwen3.5 tier — a latency-floor probe for the scheduling task.
# The benchmark drives one endpoint:
#   REPLICAS=1 GPU_MEM_UTIL=0.50 ./run-model.sh qwen3.5-2b
# =============================================================================

# Upstream Qwen/Qwen3.5-2B (BF16, ~4.5 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.5-2B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-4}"                 # 2 replicas/GPU (~4.5 GB weights each)
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.25}"      # 12.0 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
BASE_PORT="${BASE_PORT:-8900}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
