# =============================================================================
# Recipe: Gemma 4 E4B — 4B dense, BF16 (~16 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 2 replicas = 1 per GPU
#
#   per-GPU budget : 1 × 0.45 = 0.45 of 48 GiB
#   per replica    : 21.6 GiB = 16.0 weights + ~2.5 runtime + ~3.1 KV (fp8 @ 32K)
#
# Why: small agentic workhorse with native structured JSON + function calling.
# The benchmark drives one endpoint:
#   REPLICAS=1 GPU_MEM_UTIL=0.60 ./run-model.sh gemma4-e4b
# =============================================================================

# Upstream google/gemma-4-E4B-it (BF16, ~16 GB). Gemma is gated on HF —
# export HF_TOKEN before launching. Override MODEL= for a quantized build.
MODEL="${MODEL:-google/gemma-4-E4B-it}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-2}"                 # 1 replica/GPU (~16 GB weights each)
TP="${TP:-1}"                             # one replica per pinned GPU (no PCIe all-reduce)
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.45}"      # 21.6 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"        # sweep traffic = few concurrent turns per replica
BASE_PORT="${BASE_PORT:-8100}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-hermes}"   # native function calling
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"                  # native structured JSON
EXPECT_REASONING="${EXPECT_REASONING:-0}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
