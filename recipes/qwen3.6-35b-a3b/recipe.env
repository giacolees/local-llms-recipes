# =============================================================================
# Recipe: Qwen3.6-35B-A3B — 35B total / 3B active MoE, BF16 (~71.9 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 1 replica, TP=2
#
#   per-GPU budget : 1 × 0.80 = 0.80 of 48 GiB (weights sharded across both GPUs)
#   per replica    : 38.4 GiB/GPU = ~36 weights + runtime + KV (fp8 @ 32K)
#
# Why: best capability-per-token on this rig — 3B active params means ~9× less
# per-token weight traffic than the dense 27B recipe while answering at the
# 35B quality tier. One TP=2 replica; the benchmark drives it as
#   REPLICAS=1 TP=2 GPU_MEM_UTIL=0.80 ./run-model.sh qwen3.6-35b-a3b
# =============================================================================

# Upstream Qwen/Qwen3.6-35B-A3B (BF16, ~71.9 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.6-35B-A3B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-1}"                 # one TP=2 replica fits 96 GB
TP="${TP:-2}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.80}"      # 38.4 GiB per GPU of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8500}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
