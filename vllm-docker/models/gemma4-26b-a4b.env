# =============================================================================
# Recipe: Gemma 4 26B-A4B — 26B total / 3.8B active MoE, INT4 (~16 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 4 replicas = 2 per GPU
#
#   per-GPU budget : 2 × 0.45 = 0.90 of 48 GiB
#   per replica    : 21.6 GiB = 16 weights + ~3.0 runtime + ~2.6 KV (fp8 @ 32K)
#
# Why: structured JSON + function calling at the 26B quality tier for a 3.8B
# active-param cost. The 256K context headline needs a dedicated profile —
# one replica at a time:
#   REPLICAS=1 GPU_MEM_UTIL=0.90 MAX_MODEL_LEN=262144 ./run-model.sh gemma4-26b-a4b
# =============================================================================

# INT4/AWQ build of gemma-4-26b-a4b-it (~16 GB weights). Gemma is gated on HF —
# export HF_TOKEN before launching. Override MODEL= if your quant repo differs.
MODEL="${MODEL:-google/gemma-4-26b-a4b-it-awq}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-4}"                 # ~4 fit on 96 GB
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.45}"      # 21.6 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"   # 256K ctx: use the dedicated profile above
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8400}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-hermes}"   # native function calling
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"                  # native structured JSON
EXPECT_REASONING="${EXPECT_REASONING:-0}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
