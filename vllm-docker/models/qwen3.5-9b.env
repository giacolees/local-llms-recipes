# =============================================================================
# Recipe: Qwen3.5-9B — 9B dense, BF16 (~19.3 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 2 replicas = 1 per GPU
#
#   per-GPU budget : 1 × 0.50 = 0.50 of 48 GiB
#   per replica    : 24.0 GiB = 19.3 weights + ~2.0 runtime + ~2.7 KV (fp8 @ 32K)
#
# Why: cheap workhorse for single-turn sweeps. The benchmark drives one endpoint:
#   REPLICAS=1 GPU_MEM_UTIL=0.60 ./run-model.sh qwen3.5-9b
# =============================================================================

# Upstream Qwen/Qwen3.5-9B (BF16, ~19.3 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.5-9B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-2}"                 # 1 replica/GPU (~19 GB weights each)
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.50}"      # 24.0 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
BASE_PORT="${BASE_PORT:-8200}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
