# =============================================================================
# Recipe: Qwen3.6-35B-A3B — 35B total / 3B active MoE, INT4 (~21 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 2 replicas = 1 per GPU
#
#   per-GPU budget : 1 × 0.60 = 0.60 of 48 GiB (2 replicas would need >48 GiB)
#   per replica    : 28.8 GiB = 21 weights + ~3.5 runtime + ~4.3 KV (fp8 @ 32K)
#
# Why: best capability-per-token on this rig — 3B active params means ~9× less
# per-token weight traffic than the dense 27B recipe while answering at the
# 35B quality tier. Run one replica per GPU with TP=1 (no PCIe all-reduce).
# =============================================================================

# INT4/AWQ build of Qwen3.6-35B-A3B (~21 GB weights). Override MODEL= if yours differs.
MODEL="${MODEL:-Qwen/Qwen3.6-35B-A3B-AWQ}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-2}"                 # ~2 fit on 96 GB (one per GPU)
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.60}"      # 28.8 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8500}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
