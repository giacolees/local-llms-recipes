# =============================================================================
# Recipe: Phi-4 — 14B dense, BF16 (~28 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 1 replica, TP=1
#
#   per-GPU budget : 1 × 0.70 = 0.70 of 48 GiB
#   per replica    : 33.6 GiB = 28 weights + ~2.5 runtime + ~3.1 KV (fp8 @ 16K)
#
# Why: middle ground when the 4–9B tier fails the quality gate. Structured JSON
# via guided decoding; no native tool calling (EXPECT_TOOL_CALL=0) — route
# function-calling traffic to the Gemma/Qwen recipes instead. The 16K native
# context is a real limit: large agentic prompts raise on it.
# =============================================================================

# Upstream microsoft/Phi-4 (BF16, ~28 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-microsoft/Phi-4}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-1}"                 # ~28 GB weights on one GPU
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.70}"      # 33.6 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-16384}"   # Phi-4 native context
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8300}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-0}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-0}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
