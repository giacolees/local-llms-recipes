# =============================================================================
# Recipe: Qwen3.5-4B — 4B dense, BF16 (~9.3 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 4 replicas = 2 per GPU
#
#   per-GPU budget : 2 × 0.30 = 0.60 of 48 GiB
#   per replica    : 14.4 GiB = 9.3 weights + ~2.0 runtime + ~3.1 KV (fp8 @ 32K)
#
# Why: smallest tier for a latency/quality read — same lineage as Qwen3.5-9B.
# The benchmark drives one endpoint:
#   REPLICAS=1 GPU_MEM_UTIL=0.60 ./run-model.sh qwen3.5-4b
# =============================================================================

# Upstream Qwen/Qwen3.5-4B (BF16, ~9.3 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.5-4B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-4}"                 # 2 replicas/GPU (~9 GB weights each)
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.30}"      # 14.4 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
BASE_PORT="${BASE_PORT:-8800}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
