# =============================================================================
# Recipe: Gemma 4 E4B — 4B dense, INT4 (~2.5 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 12 replicas = 6 per GPU
#
#   per-GPU budget : 6 × 0.15 = 0.90 of 48 GiB  (≈ 4.8 GiB headroom for CUDA ctx)
#   per replica    : 7.2 GiB = 2.5 weights + ~2.0 runtime + ~2.7 KV (fp8 @ 32K)
#
# Why: maximum parallelism for single-turn agentic sweeps; native structured
# JSON + function calling. 12 replicas is the "max parallelism" setting —
# use REPLICAS=10 GPU_MEM_UTIL=0.17 if you want more KV headroom per replica.
# =============================================================================

# INT4/AWQ build of gemma-4-e4b-it (~2.5 GB weights). Gemma is gated on HF —
# export HF_TOKEN before launching. Override MODEL= if your quant repo differs.
MODEL="${MODEL:-google/gemma-4-e4b-it-awq}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-12}"                # ~10–12 fit on 96 GB; 12 = max parallelism
TP="${TP:-1}"                             # one replica per pinned GPU (no PCIe all-reduce)
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.15}"      # 7.2 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"        # sweep traffic = few concurrent turns per replica
BASE_PORT="${BASE_PORT:-8100}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-hermes}"   # native function calling
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"                  # native structured JSON
EXPECT_REASONING="${EXPECT_REASONING:-0}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
