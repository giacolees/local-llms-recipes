# =============================================================================
# Recipe: Qwen3.5-0.8B — 0.8B dense, BF16 (~1.7 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 8 replicas = 4 per GPU
#
#   per-GPU budget : 4 × 0.15 = 0.60 of 48 GiB
#   per replica    : 7.2 GiB = 1.7 weights + ~2.0 runtime + ~3.5 KV (fp8 @ 32K)
#
# Why: absolute latency floor for the scheduling task (capability ceiling probe).
# The benchmark drives one endpoint:
#   REPLICAS=1 GPU_MEM_UTIL=0.40 ./run-model.sh qwen3.5-0.8b
# =============================================================================

# Upstream Qwen/Qwen3.5-0.8B (BF16, ~1.7 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.5-0.8B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-8}"                 # 4 replicas/GPU (~1.7 GB weights each)
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.15}"      # 7.2 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
BASE_PORT="${BASE_PORT:-9000}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
