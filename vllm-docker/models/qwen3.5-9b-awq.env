# =============================================================================
# Recipe: Qwen3.5-9B AWQ — 9B dense, INT4 (~5.5 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 8 replicas = 4 per GPU
#
#   per-GPU budget : 4 × 0.22 = 0.88 of 48 GiB
#   per replica    : 10.6 GiB = 5.5 weights + ~2.0 runtime + ~3.1 KV (fp8 @ 32K)
#
# Why: cheap workhorse for single-turn sweeps — the 9B tier is the default
# "just answer" model when E4B-level parallelism isn't needed.
# =============================================================================

# Official Qwen AWQ build (~5.5 GB weights). Override MODEL= if your repo differs.
MODEL="${MODEL:-Qwen/Qwen3.5-9B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-8}"                 # ~8 fit on 96 GB
TP="${TP:-1}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.22}"      # 10.6 GiB per replica of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
BASE_PORT="${BASE_PORT:-8200}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
