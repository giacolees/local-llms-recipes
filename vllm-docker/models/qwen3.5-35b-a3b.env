# =============================================================================
# Recipe: Qwen3.5-35B-A3B — 35B total / 3B active MoE (multimodal), FP8 (~37.5 GB)
# Target hardware: 2× RTX A6000 (96 GB) — 1 replica, TP=2 across both GPUs
#
#   per-GPU budget : 0.90 × 48 GiB = 43.2 GiB
#   measured peak  : ~42.4 GiB/GPU (weights + runtime + fp8 KV @ 32K)
#
# Why TP=2 instead of one replica per GPU: there is no official AWQ/INT4 build
# (Qwen/Qwen3.5-35B-A3B-AWQ does not exist), and the base
# Qwen/Qwen3.5-35B-A3B checkpoint is 71.9 GB BF16 and does not fit. FP8 is the
# only official quantized build; it runs on Ampere through vLLM's Marlin FP8
# kernels. The 37.5 GB of weights do not fit one 48 GiB card alongside KV, so
# this recipe is a single TP=2 replica spanning both GPUs.
#
# This is a reasoning model (and a VL/MoE one): left to itself it will spend any
# token budget in reasoning_content and return content=null. Thinking is
# therefore disabled by default (measured: enable_thinking=false -> finish=stop
# at 11 tokens; default -> 600/600 tokens consumed, content=null). Clients that
# want chain-of-thought can opt back in with
#   "chat_template_kwargs": {"enable_thinking": true}
# =============================================================================

# Official FP8 build (~37.5 GB). Override MODEL= if yours differs.
MODEL="${MODEL:-Qwen/Qwen3.5-35B-A3B-FP8}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-1}"                 # weights exceed one 48 GiB card
TP="${TP:-2}"                             # split the single replica across both GPUs
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"      # 43.2 GiB per GPU of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8700}"

# Default to non-thinking so JSON/tool-call responses return content. Keep the
# JSON compact: lib.sh word-splits EXTRA_ARGS, and quotes stay literal.
EXTRA_ARGS="${EXTRA_ARGS:---default-chat-template-kwargs {\"enable_thinking\":false}}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"
