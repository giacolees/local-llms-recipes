# =============================================================================
# Recipe: Qwen3.6-27B — 27B dense, BF16 (~55.6 GB weights)
# Target hardware: 2× RTX A6000 (96 GB) — 1 replica, TP=2
#
#   per-GPU budget : 1 × 0.70 = 0.70 of 48 GiB (weights sharded across both GPUs)
#   per replica    : 33.6 GiB/GPU = ~27.8 weights + runtime + KV (fp8 @ 32K)
#
#   !!! NOT RECOMMENDED — kept only as the A/B control for the gate tests !!!
#   A dense 27B reads ~27B weights per generated token, ≈ 9× the per-token
#   weight traffic of the 3B-active Qwen3.6-35B-A3B MoE at lower capability.
#   Use qwen3.6-35b-a3b instead unless you are measuring the dense-vs-MoE gap.
# =============================================================================

# Upstream Qwen/Qwen3.6-27B (BF16, ~55.6 GB). Override MODEL= for a quantized build.
MODEL="${MODEL:-Qwen/Qwen3.6-27B}"
QUANTIZATION="${QUANTIZATION:-}"          # empty = auto-detect from checkpoint

REPLICAS="${REPLICAS:-1}"                 # one TP=2 replica fits 96 GB
TP="${TP:-2}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.70}"      # 33.6 GiB per GPU of 48 GiB
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
BASE_PORT="${BASE_PORT:-8600}"

# --- Capability flags (consumed by tests/test-model.sh) ---
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_xml}"
EXPECT_TOOL_CALL="${EXPECT_TOOL_CALL:-1}"
EXPECT_JSON="${EXPECT_JSON:-1}"
EXPECT_REASONING="${EXPECT_REASONING:-1}"

EXTRA_ARGS="${EXTRA_ARGS:-}"
